[Unit]
Description=Dock guest init (config from kernel command line, disk grow)
DefaultDependencies=no
After=local-fs.target
Before=dock-fast-agent.service systemd-networkd.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/dock-guest-init

[Install]
WantedBy=multi-user.target
